 # All rights reserved.
@@ -71,7 +81,7 @@
     host_plat = platform.platform();
 
     def create(self):
-        print "syborg_nvmemorydevice: create\n"
+        print "syborg_nvmemorydevice: create (phorepoc-fixed plugin)\n"
         
         # Get properties
         self.drive_size = self.properties["drive_size"]
@@ -100,6 +110,23 @@
         except Exception, e:
             print repr(e)
             sys.exit("syborg_nvmemorydevice: nvmemmory load failed")
+
+        # Phorepoc fix: real prototypes (see header comment)
+        L = self.nvmemlib
+        L.nvmem_create.restype = ctypes.c_void_p
+        L.nvmem_create.argtypes = [ctypes.c_uint32]
+        L.nvmem_reset.restype = ctypes.c_int32
+        L.nvmem_reset.argtypes = [ctypes.c_void_p]
+        L.nvmem_open.restype = ctypes.c_int32
+        L.nvmem_open.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
+        L.nvmem_get_sector_count.restype = ctypes.c_int32
+        L.nvmem_get_sector_count.argtypes = [ctypes.c_void_p, ctypes.c_int32]
+        L.nvmem_read.restype = None
+        L.nvmem_read.argtypes = [ctypes.c_void_p, ctypes.c_void_p,
+                                 ctypes.c_int32, ctypes.c_uint32, ctypes.c_uint32]
+        L.nvmem_write.restype = None
+        L.nvmem_write.argtypes = [ctypes.c_void_p, ctypes.c_void_p,
+                                  ctypes.c_int32, ctypes.c_uint32, ctypes.c_uint32]
         
         # Create an instance of non volatile memory handler class
