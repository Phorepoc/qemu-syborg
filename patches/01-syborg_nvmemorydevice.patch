         self.CALLBACKFUNC = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int)
         self.nvmem_callback = self.CALLBACKFUNC(self.nvmem_request_callback)
+        # Phorepoc fix: void* object pointer, real callback type
