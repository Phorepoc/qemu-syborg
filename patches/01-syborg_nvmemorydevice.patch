             self.shared_memory_size = value
         elif offset == self.R_NVMEM_ENABLE:
             if( value > 0 ):
-                self.nvmemory_memregion = qemu.memregion( self.shared_memory_base, self.shared_memory_size )
-                self.nvmemory_sharedmemory_host_address = self.nvmemory_memregion.region_host_addr()
+                # Phorepoc fix (64-bit host): python-plugin.c qemu_py_memregion_init parses its
+                # uint32_t base/size with PyArg format "ll" -- a C long is 8 bytes on x86_64
+                # Linux, so parsing `size` zeroes `base` on the stack and the region silently
+                # maps guest-physical 0. Every transfer then went to/from phys 0 instead of the
+                # driver's buffer: the guest FS only ever saw its own caches (garbage `dir C:`,
+                # a valid pre-built image read back as KErrCorrupt) AND low guest RAM got
+                # scribbled. Map base 0 explicitly (immune to the clobber) and add the offset
+                # ourselves -- syborg RAM is one contiguous block from guest-physical 0.
+                self.nvmemory_memregion = qemu.memregion( 0, self.shared_memory_size )
+                self.nvmemory_sharedmemory_host_address = \
